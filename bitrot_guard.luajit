#!/usr/bin/env luajit

local ffi = require("ffi")

ffi.cdef([[
int execv(const char *path, char *const argv[]);
]])

local function die(msg)
	io.stderr:write(msg .. "\n")
	os.exit(1)
end

local function dirname(path)
	local i = path:match("^.*()/")
	if not i then
		return "."
	end
	if i == 1 then
		return "/"
	end
	return path:sub(1, i - 1)
end

local script_dir = dirname(arg[0])
local bash_path = script_dir .. "/bitrot_guard.bash"

local argv0 = os.getenv("BRG_ARGV0")
if argv0 == nil or argv0 == "" then
	argv0 = bash_path
end

local argv = { argv0 }
for i = 1, #arg do
	argv[#argv + 1] = arg[i]
end

local cargv = ffi.new("char *[?]", #argv + 1)
for i = 1, #argv do
	cargv[i - 1] = ffi.cast("char *", argv[i])
end
cargv[#argv] = nil

ffi.C.execv(bash_path, cargv)
die("Error: exec failed running bitrot_guard.bash")
