sqlite_escape() {
	local value="$1"
	printf '%s' "$value" | $SED "s/'/''/g"
}

sqlite_ensure_par2_schema() {
	local db="$1"
	sqlite3 "$db" <<'SQL'
create table if not exists brg_par2_files (
	source_path text not null,
	source_uid integer not null,
	source_gid integer not null,
	source_mode integer not null,
	source_mtime integer not null,
	par2_name text not null,
	par2_content blob not null,
	primary key (source_path, source_uid, source_gid, source_mode, source_mtime, par2_name)
);
create index if not exists brg_par2_files_lookup on brg_par2_files (
	source_path,
	source_uid,
	source_gid,
	source_mode,
	source_mtime
);
SQL
}

sqlite_require_fileio_functions() {
	local db="$1"
	if ! command -v sqlite3 >/dev/null 2>&1; then
		echo "Error: sqlite3 is required when BRG_PAR2_STORE=sqlite" >&2
		return 1
	fi

	local tmp_probe
	if ! tmp_probe=$(mktemp --tmpdir "brg_sqlite_writefile_probe.XXXXXX"); then
		echo "Error: Failed to create sqlite writefile probe temp file" >&2
		return 1
	fi
	rm -f "$tmp_probe" 2>/dev/null || true

	local db_sql tmp_sql
	db_sql=$(sqlite_escape "$db")
	tmp_sql=$(sqlite_escape "$tmp_probe")

	if ! sqlite3 -batch :memory: "select length(readfile('$db_sql'));" >/dev/null 2>&1; then
		echo "Error: bitrot_guard requires sqlite3 with readfile() and writefile() enabled for BRG_PAR2_STORE=sqlite." >&2
		return 1
	fi
	if ! sqlite3 -batch :memory: "select writefile('$tmp_sql', X'');" >/dev/null 2>&1; then
		echo "Error: bitrot_guard requires sqlite3 with readfile() and writefile() enabled for BRG_PAR2_STORE=sqlite." >&2
		return 1
	fi
	rm -f "$tmp_probe" 2>/dev/null || true
	return 0
}

