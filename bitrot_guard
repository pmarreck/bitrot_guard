IFS=$'\n\t'

resolve_script_dir() {
	local source="${BASH_SOURCE[0]}"
	if [[ ! "$source" =~ ^/ ]]; then
		source="$PWD/$source"
	fi
	while [[ -L "$source" ]]; do
		local dir
		dir=$(cd -P "$(dirname "$source")" && pwd)
		local target
		target=$(readlink "$source") || return 1
		if [[ "$target" == /* ]]; then
			source="$target"
		else
			source="$dir/$target"
		fi
	done
	cd -P "$(dirname "$source")" && pwd
}

SCRIPT_DIR=$(resolve_script_dir)
TEST_SCRIPT="$SCRIPT_DIR/test/test.sh"

queue_plan() {
	local workers=${BRG_WORKERS:-$(get_cpu_cores)}
	if ! [[ "$workers" =~ ^[0-9]+$ ]] || ((workers < 1)); then
		workers=1
	fi
	local IFS=$'\n'
	local tasks=()
	while IFS=$'\t' read -r size path; do
		[[ -z "$size" || -z "$path" ]] && continue
		if ! [[ "$size" =~ ^[0-9]+$ ]]; then
			continue
		fi
		tasks+=("$size"$'\t'"$path")
	done
	if ((${#tasks[@]} == 0)); then
		return 0
	fi
	mapfile -t tasks < <(printf '%s\n' "${tasks[@]}" | LC_ALL=C sort -t $'\t' -k1,1nr)
	local -a loads
	local -a assignments
	for ((i=0; i<workers; i++)); do
		loads[i]=0
		assignments[i]=''
	done
	for task in "${tasks[@]}"; do
		local size path assignment_index
		size=${task%%$'\t'*}
		path=${task#*$'\t'}
		assignment_index=0
		for ((i=1; i<workers; i++)); do
			if (( loads[i] < loads[assignment_index] )); then
				assignment_index=$i
			fi
		done
		loads[assignment_index]=$((loads[assignment_index]+size))
		if [[ -z ${assignments[assignment_index]} ]]; then
			assignments[assignment_index]="$path"
		else
			assignments[assignment_index]+=" $path"
		fi
	done
	for ((i=0; i<workers; i++)); do
		printf 'worker%u\t%s\t%s\n' "$((i+1))" "${loads[i]}" "${assignments[i]}"
	done
}

emit_sorted_file_list() {
	local root="$1"
	local -a entries=()
	while IFS= read -r -d '' file; do
		if should_ignore_path "$file" "$root"; then
			continue
		fi
		local size_bytes
		if ! size_bytes=$($STAT -c%s "$file" 2>/dev/null); then
			continue
		fi
		local size_kb=$(((size_bytes + 1023) / 1024))
		entries+=("$size_kb"$'\t'"$file")
	done
	if ((${#entries[@]} == 0)); then
		return 0
	fi
	printf '%s\n' "${entries[@]}" | LC_ALL=C sort -t $'\t' -k1,1nr
}

emit_update_file_list() {
	local root="$1"
	local -a entries=()
	while IFS= read -r -d '' file; do
		if should_ignore_path "$file" "$root"; then
			continue
		fi
		local par2_path
		par2_path=$(get_par2_path "$file")
		local file_time par2_time
		if ! file_time=$($STAT -c%Y "$file" 2>/dev/null); then
			continue
		fi
		if [[ -f "$par2_path" ]]; then
			par2_time=$($STAT -c%Y "$par2_path" 2>/dev/null || printf '0')
		else
			par2_time=0
		fi
		if (( file_time <= par2_time )); then
			continue
		fi
		local size_bytes size_kb
		if ! size_bytes=$($STAT -c%s "$file" 2>/dev/null); then
			continue
		fi
		size_kb=$(((size_bytes + 1023) / 1024))
		entries+=("$size_kb"$'\t'"$file")
	done
	if ((${#entries[@]} == 0)); then
		return 0
	fi
	printf '%s\n' "${entries[@]}" | LC_ALL=C sort -t $'\t' -k1,1nr
}

list_files_for_mode() {
	local mode="$1"
	local target="$2"
	local root
	if ! root=$(resolve_realpath "$target" 2>/dev/null); then
		root="$target"
	fi
	case "$mode" in
		create|verify)
			emit_sorted_file_list_from_find "$root"
			;;
		update)
			emit_update_file_list_from_find "$root"
			;;
		*)
			echo "Error: Unknown queue-files mode '$mode'." >&2
			return 1
			;;
	esac
}

emit_sorted_file_list_from_find() {
	local root="$1"
	emit_sorted_file_list "$root" < <(find "$root" -type f -not -name '*.par2' -not -name '*.brg_empty' -print0)
}

emit_update_file_list_from_find() {
	local root="$1"
	emit_update_file_list "$root" < <(find "$root" -type f -not -name '*.par2' -not -name '*.brg_empty' -print0)
}

queue_files_command() {
	local mode="$1"
	local target="$2"
	if [[ -z "$mode" || -z "$target" ]]; then
		echo "Error: queue-files requires a mode and a target path." >&2
		return 1
	fi
	list_files_for_mode "$mode" "$target"
}

falsey() {
	local arg="${1:-}"
	case "$arg" in
		--help)
			cat <<EOF
Usage: truthy VARIABLE|value
Returns success if the input is truthy, failure otherwise.

Usage: falsey VARIABLE|value
Returns success if the input is falsey (unset, empty, or values like 0/false/off/no/disable).
EOF
			return 0
			;;
		--test)
			return 0
			;;
		"" )
			return 0
			;;
	esac

	local value
	if [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
		if [[ ${!arg+x} ]]; then
			value="${!arg}"
		else
			return 0
		fi
	else
		value="$arg"
	fi

	local lower
	lower=$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')
	case "$lower" in
		""|0|f|false|off|n|no|disable|disabled)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

truthy() {
	local arg="${1:-}"
	case "$arg" in
		--help|--test)
			falsey "$arg"
			return 0
			;;
	esac
	falsey "$arg"
	local rc=$?
	if [[ $rc -eq 0 ]]; then
		return 1
	elif [[ $rc -eq 1 ]]; then
		return 0
	else
		return $rc
	fi
}

# Get number of CPU cores based on OS
get_cpu_cores() {
	if [[ "$OSTYPE" == "darwin"* ]]; then
		sysctl -n hw.ncpu
	else
		nproc
	fi
}

is_macos() {
	[[ "$OSTYPE" == "darwin"* ]]
}

realpath_supported() {
	if command -v greadlink >/dev/null 2>&1; then
		return 0
	fi
	if command -v readlink >/dev/null 2>&1; then
		return 0
	fi
	return 1
}

resolve_realpath_with_readlink() {
	local target="$1"
	local current="$target"
	local max_symlinks=40

	if [[ ! "$current" =~ ^/ ]]; then
		current="$PWD/$current"
	fi

	while ((max_symlinks--)); do
		if [[ -L "$current" ]]; then
			local link
			if ! link=$(readlink "$current"); then
				return 1
			fi
			if [[ "$link" == /* ]]; then
				current="$link"
			else
				current="$(dirname "$current")/$link"
			fi
			continue
		fi

		if [[ -d "$current" ]]; then
			( cd "$current" 2>/dev/null && pwd -P )
			return $?
		fi

		if [[ -e "$current" ]]; then
			local dir
			dir=$(dirname "$current")
			local base
			base=$(basename "$current")
			if ! dir=$(cd "$dir" 2>/dev/null && pwd -P); then
				return 1
			fi
			printf '%s/%s\n' "$dir" "$base"
			return 0
		fi

		return 1
	done

	return 1
}

resolve_realpath() {
	local target="$1"
	local resolved

	if command -v greadlink >/dev/null 2>&1; then
		if resolved=$(greadlink -f "$target" 2>/dev/null); then
			printf '%s\n' "$resolved"
			return 0
		fi
	fi

	if command -v readlink >/dev/null 2>&1; then
		if resolved=$(resolve_realpath_with_readlink "$target"); then
			printf '%s\n' "$resolved"
			return 0
		fi
	fi

	return 1
}

