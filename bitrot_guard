sqlite_store_par2_file() {
	local db="$1"
	local source_path="$2"
	local source_uid="$3"
	local source_gid="$4"
	local source_mode="$5"
	local source_mtime="$6"
	local par2_name="$7"
	local par2_path="$8"

	local source_path_sql par2_name_sql
	source_path_sql=$(sqlite_escape "$source_path")
	par2_name_sql=$(sqlite_escape "$par2_name")

	local par2_path_sql
	par2_path_sql=$(sqlite_escape "$par2_path")

	sqlite3 "$db" "insert or replace into brg_par2_files (source_path, source_uid, source_gid, source_mode, source_mtime, par2_name, par2_content) values ('$source_path_sql', $source_uid, $source_gid, $source_mode, $source_mtime, '$par2_name_sql', readfile('$par2_path_sql'));"
}

sqlite_store_create_for_file() {
	local file="$1"

	if ! command -v sqlite3 >/dev/null 2>&1; then
		echo "Error: sqlite3 is required when BRG_PAR2_STORE=sqlite" >&2
		return 1
	fi

	local db
	db=$(brg_par2_db_path)
	local db_dir
	db_dir=$(dirname "$db")
	mkdir -p "$db_dir"

	if ! sqlite_require_fileio_functions "$db"; then
		return 1
	fi

	if ! sqlite_ensure_par2_schema "$db"; then
		echo "Error: Failed to initialize sqlite par2 schema at $db" >&2
		return 1
	fi

	local canonical
	if ! canonical=$(resolve_realpath "$file"); then
		canonical="$file"
	fi

	local source_uid source_gid source_mode source_mtime
	source_uid=$($STAT -c%u "$file")
	source_gid=$($STAT -c%g "$file")
	source_mode=$($STAT -c%a "$file")
	source_mtime=$($STAT -c%Y "$file")

	local tmpdir
	if ! tmpdir=$(mktemp -d --tmpdir "brg_par2.XXXXXX"); then
		echo "Error: Failed to create temporary directory for sqlite par2 output" >&2
		return 1
	fi

	local tmp_par2_base
	tmp_par2_base="$tmpdir/$(basename "$(get_par2_path "$file")")"
	local file_dir
	file_dir=$(dirname "$file")

	local file_size block_size
	file_size=$($STAT -c%s "$file")
	block_size=$(calculate_block_size "$file_size")

	if ! $PAR2 create -B"$file_dir" -s"$block_size" -r"$BRG_REDUNDANCY" -n1 -T"$NUM_PAR2_THREADS" "$tmp_par2_base" "$file" >/dev/null; then
		rm -rf "$tmpdir"
		echo -e "\nError creating par2 for $file" >&2
		return 1
	fi

	local par2f
	for par2f in "${tmp_par2_base%.*}".vol*.par2 "${tmp_par2_base%.*}".par2; do
		[[ -f "$par2f" ]] || continue
		if ! sqlite_store_par2_file "$db" "$canonical" "$source_uid" "$source_gid" "$source_mode" "$source_mtime" "$(basename "$par2f")" "$par2f"; then
			rm -rf "$tmpdir"
			echo "Error: Failed storing par2 into sqlite for $file" >&2
			return 1
		fi
	done

	rm -rf "$tmpdir"
}

sqlite_materialize_latest_par2_set_for_file() {
	local file="$1"
	local tmpdir="$2"

	local db
	db=$(brg_par2_db_path)
	[[ -f "$db" ]] || return 1

	local canonical
	if ! canonical=$(resolve_realpath "$file"); then
		canonical="$file"
	fi

	local source_uid source_gid source_mode
	source_uid=$($STAT -c%u "$file")
	source_gid=$($STAT -c%g "$file")
	source_mode=$($STAT -c%a "$file")

	local canonical_sql
	canonical_sql=$(sqlite_escape "$canonical")

	local tmpdir_sql query
	tmpdir_sql=$(sqlite_escape "$tmpdir")
	query=$(
		cat <<SQL
select par2_name, writefile('$tmpdir_sql/' || par2_name, par2_content)
from brg_par2_files
where source_path = '$canonical_sql'
	and source_uid = $source_uid
	and source_gid = $source_gid
	and source_mode = $source_mode
	and source_mtime = (
		select max(source_mtime)
		from brg_par2_files
		where source_path = '$canonical_sql'
			and source_uid = $source_uid
			and source_gid = $source_gid
			and source_mode = $source_mode
	);
SQL
	)

	local main_par2=""
	while IFS=$'\t' read -r par2_name bytes_written; do
		[[ -z "$par2_name" ]] && continue
		if [[ -z "$main_par2" && "$par2_name" == *.par2 && "$par2_name" != *.vol*.par2 ]]; then
			main_par2="$tmpdir/$par2_name"
		fi
	done < <(sqlite3 -noheader -separator $'\t' "$db" "$query")

	[[ -n "$main_par2" ]] || return 1
	printf '%s\n' "$main_par2"
}

sqlite_store_clear_for_file() {
	local file="$1"

	if ! command -v sqlite3 >/dev/null 2>&1; then
		return 0
	fi

	local db
	db=$(brg_par2_db_path)
	[[ -f "$db" ]] || return 0

	local canonical
	if ! canonical=$(resolve_realpath "$file"); then
		canonical="$file"
	fi

	local canonical_sql
	canonical_sql=$(sqlite_escape "$canonical")

	sqlite3 "$db" "delete from brg_par2_files where source_path = '$canonical_sql';"
}

sqlite_store_latest_mtime_for_file() {
	local file="$1"

	local db
	db=$(brg_par2_db_path)
	[[ -f "$db" ]] || return 1

	local canonical
	if ! canonical=$(resolve_realpath "$file"); then
		canonical="$file"
	fi

	local source_uid source_gid source_mode
	source_uid=$($STAT -c%u "$file")
	source_gid=$($STAT -c%g "$file")
	source_mode=$($STAT -c%a "$file")

	local canonical_sql
	canonical_sql=$(sqlite_escape "$canonical")

	sqlite3 "$db" "select max(source_mtime) from brg_par2_files where source_path = '$canonical_sql' and source_uid = $source_uid and source_gid = $source_gid and source_mode = $source_mode;"
}

sqlite_prune_missing_sources() {
	local target="$1"

	if ! command -v sqlite3 >/dev/null 2>&1; then
		echo "Error: sqlite3 is required when BRG_PAR2_STORE=sqlite" >&2
		return 1
	fi

	local db
	db=$(brg_par2_db_path)
	[[ -f "$db" ]] || return 0

	local target_canon
	if ! target_canon=$(resolve_realpath "$target" 2>/dev/null); then
		target_canon="$target"
	fi
	target_canon="${target_canon%/}"

	local target_sql
	target_sql=$(sqlite_escape "$target_canon")

	local query
	if [[ -d "$target_canon" ]]; then
		local like_prefix
		like_prefix=$(printf '%s' "$target_canon" | $SED 's/[\\%_]/\\&/g')
		like_prefix="${like_prefix%/}"
		local like_sql
		like_sql=$(sqlite_escape "$like_prefix")
		query="select distinct source_path from brg_par2_files where source_path like '$like_sql/%' escape '\\';"
	else
		query="select distinct source_path from brg_par2_files where source_path = '$target_sql';"
	fi

	local source_path
	while IFS= read -r source_path; do
		[[ -z "$source_path" ]] && continue
		if [[ ! -f "$source_path" ]]; then
			local source_path_sql
			source_path_sql=$(sqlite_escape "$source_path")
			sqlite3 "$db" "delete from brg_par2_files where source_path = '$source_path_sql';" >/dev/null
		fi
	done < <(sqlite3 -noheader "$db" "$query")

	return 0
}

sqlite_clear_scope() {
	local target="$1"

	local db
	db=$(brg_par2_db_path)
	[[ -f "$db" ]] || return 0

	local target_canon
	if ! target_canon=$(resolve_realpath "$target" 2>/dev/null); then
		target_canon="$target"
	fi
	target_canon="${target_canon%/}"

	local target_sql
	target_sql=$(sqlite_escape "$target_canon")

	local query
	if [[ -d "$target_canon" ]]; then
		local like_prefix
		like_prefix=$(printf '%s' "$target_canon" | $SED 's/[\\%_]/\\&/g')
		like_prefix="${like_prefix%/}"
		local like_sql
		like_sql=$(sqlite_escape "$like_prefix")
		query="delete from brg_par2_files where source_path like '$like_sql/%' escape '\\';"
	else
		query="delete from brg_par2_files where source_path = '$target_sql';"
	fi

	sqlite3 "$db" "$query" >/dev/null
}

brg_store_prune_scope() {
	local target="$1"
	if par2_store_is_sqlite; then
		sqlite_prune_missing_sources "$target"
	else
		filesystem_prune_orphaned_par2s "$target"
	fi
}

brg_store_clear_scope() {
	local target="$1"
	if par2_store_is_sqlite; then
		sqlite_clear_scope "$target"
		if [[ -d "$target" ]]; then
			while IFS= read -r -d '' marker; do
				if should_ignore_path "$marker" "$target"; then
					continue
				fi
				rm -f "$marker" 2>/dev/null || true
			done < <(find "$target" -type f -name "*.brg_empty" -print0)
		fi
	else
		clear_par2s "$target"
	fi
}

filesystem_prune_orphaned_par2s() {
	local target="$1"
	local root="$target"
	if [[ -f "$root" ]]; then
		root=$(dirname "$root")
	fi
	local normalized_root
	if ! normalized_root=$(resolve_realpath "$root" 2>/dev/null); then
		normalized_root="$root"
	fi

	local -A keep_prefixes=()
	while IFS= read -r -d '' file; do
		if should_ignore_path "$file" "$normalized_root"; then
			continue
		fi
		local base_name
		base_name=$(basename "$file")
		if [[ "$base_name" == *.par2 ]]; then
			continue
		fi
		if [[ "$base_name" == *.brg_empty ]]; then
			continue
		fi
		local par2_path prefix
		par2_path=$(get_par2_path "$file")
		prefix="${par2_path%.par2}"
		keep_prefixes["$prefix"]=1
		if has_resource_fork "$file"; then
			local rf_par2 rf_prefix
			rf_par2=$(get_resource_fork_par2_path "$file")
			rf_prefix="${rf_par2%.par2}"
			keep_prefixes["$rf_prefix"]=1
		fi
	done < <(find "$normalized_root" -type f -not -name '*.par2' -print0)

	while IFS= read -r -d '' marker; do
		if should_ignore_path "$marker" "$normalized_root"; then
			continue
		fi
		local marker_dir
		marker_dir=$(dirname "$marker")
		local found=0
		local candidate
		while IFS= read -r -d '' candidate; do
			if should_ignore_path "$candidate" "$normalized_root"; then
				continue
			fi
			local candidate_base
			candidate_base=$(basename "$candidate")
			if [[ "$candidate_base" == *.par2 || "$candidate_base" == *.brg_empty ]]; then
				continue
			fi
			if [[ "$(get_empty_marker_path "$candidate")" == "$marker" ]]; then
				found=1
				break
			fi
		done < <(find "$marker_dir" -maxdepth 1 -type f -print0)

		if [[ "$found" -eq 0 ]]; then
			rm -f "$marker" 2>/dev/null || true
		fi
	done < <(find "$normalized_root" -type f -name '*.brg_empty' -print0)

	local -A pruned_prefixes=()
	while IFS= read -r -d '' par2_file; do
		if should_ignore_path "$par2_file" "$normalized_root"; then
			continue
		fi
		local set_base set_prefix
		set_base="${par2_file%.par2}"
		set_prefix="${set_base%%.vol*}"
		if [[ -n "${keep_prefixes[$set_prefix]+x}" ]]; then
			continue
		fi
		if [[ -n "${pruned_prefixes[$set_prefix]+x}" ]]; then
			continue
		fi
		pruned_prefixes["$set_prefix"]=1
		local files=()
		shopt -s nullglob
		files=("${set_prefix}"*.par2)
		shopt -u nullglob
		if ((${#files[@]} > 0)); then
			rm -f "${files[@]}" 2>/dev/null || true
		fi
	done < <(find "$normalized_root" -type f -name '*.par2' -print0)
}

# Utility function to sanitize filenames for par2
sanitize_filename() {
	local filename="$1"
	# Replace wildcards, question marks, and other problematic characters with underscores
	echo "$filename" | $SED -E 's/[*?]/_/g; s/:/_/g; s/\\/_/g'
}

reset_ignore_patterns_cache() {
	BRG_IGNORE_PATTERNS_CACHE=()
	BRG_IGNORE_PATTERNS_LOADED=0
}

load_ignore_patterns() {
	if [[ "$BRG_IGNORE_PATTERNS_LOADED" -eq 1 ]]; then
		return
	fi

	local patterns
	if [[ -n "${BRG_DEFAULT_IGNORE_PATTERNS:-}" ]]; then
		IFS=':' read -r -a patterns <<< "$BRG_DEFAULT_IGNORE_PATTERNS"
	else
		patterns=("${DEFAULT_IGNORE_PATTERNS[@]}")
	fi

	if [[ -n "${BRG_ADDITIONAL_IGNORE_PATTERNS:-}" ]]; then
		local extra
		IFS=':' read -r -a extra <<< "$BRG_ADDITIONAL_IGNORE_PATTERNS"
		for pattern in "${extra[@]}"; do
			[[ -z "$pattern" ]] && continue
			patterns+=("$pattern")
		done
	fi

	if [[ -n "${BRG_IGNORE_PATTERNS:-}" ]]; then
		IFS=':' read -r -a env_patterns <<< "$BRG_IGNORE_PATTERNS"
		for pattern in "${env_patterns[@]}"; do
			[[ -z "$pattern" ]] && continue
			patterns+=("$pattern")
		done
	fi

	local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
	local config_file="$config_dir/bitrot_guard/ignore"
	if [[ -f "$config_file" ]]; then
		while IFS= read -r line || [[ -n "$line" ]]; do
			line="${line%%#*}"
			line="${line%"${line##*[![:space:]]}"}"
			line="${line#"${line%%[![:space:]]*}"}"
			[[ -z "$line" ]] && continue
			patterns+=("$line")
		done < "$config_file"
	fi

	BRG_IGNORE_PATTERNS_CACHE=("${patterns[@]}")
	BRG_IGNORE_PATTERNS_LOADED=1
}

should_ignore_path() {
	local path="$1"
	local root="${2:-}"
	load_ignore_patterns

	local rel_path="$path"
	local normalized_root="$root"
	if [[ -n "$normalized_root" && "$normalized_root" != "/" ]]; then
		normalized_root="${normalized_root%/}"
		[[ -z "$normalized_root" ]] && normalized_root="$root"
	fi

	if [[ -z "$normalized_root" ]]; then
		normalized_root="$root"
	fi

	if [[ -n "$normalized_root" ]]; then
		if [[ "$normalized_root" == "." ]]; then
			if [[ "$rel_path" == ./* ]]; then
				rel_path="${rel_path#./}"
			fi
		else
			if [[ "$rel_path" == "$normalized_root" ]]; then
				rel_path=$(basename "$rel_path")
			elif [[ "$rel_path" == "$normalized_root"/* ]]; then
				rel_path="${rel_path#"$normalized_root"/}"
			fi
		fi
	fi

	local base
	base=$(basename "$path")
	for pattern in "${BRG_IGNORE_PATTERNS_CACHE[@]}"; do
		[[ -z "$pattern" ]] && continue
		if [[ "$rel_path" == $pattern || "$path" == $pattern || "$base" == $pattern ]]; then
			debug "Ignoring $path (relative: $rel_path) via pattern $pattern"
			return 0
		fi
	done

	return 1
}

# Check if a file has a resource fork
has_resource_fork() {
	local file="$1"
	local result
	# Check named resource fork path (only on macOS)
	if is_macos; then
		# Check if resource fork exists and is not empty
		# The stat command here is expected to be GNU stat
		[[ -f "${file}/..namedfork/rsrc" && $($STAT -c%s "${file}/..namedfork/rsrc") -gt 0 ]]
		result=$?
		if [[ $result -eq 0 ]]; then
			debug "File $file has a resource fork that is also not empty"
		else
			debug "File $file does not have a resource fork or it is empty"
		fi
		return $result
	else
		return 1
	fi
}

# Utility function to get corresponding par2 path
get_par2_path() {
	local orig_path="$1"
	local base_dir=$(dirname "$orig_path")
	local base_name=$(basename "$orig_path")
	local sanitized_name=$(sanitize_filename "$base_name")
	local par2_path="${base_dir}/.${sanitized_name}.par2"
	echo "$par2_path"
}

get_empty_marker_path() {
	local orig_path="$1"
	local base_dir=$(dirname "$orig_path")
	local base_name=$(basename "$orig_path")
	local sanitized_name=$(sanitize_filename "$base_name")
	printf '%s/.%s.brg_empty\n' "$base_dir" "$sanitized_name"
}

# Get the path to a file's resource fork
get_resource_fork_path() {
	if is_macos && [[ -f "${1}/..namedfork/rsrc" ]]; then
		echo "${1}/..namedfork/rsrc"
	else
		return 1
	fi
}

# Get par2 path for resource fork
get_resource_fork_par2_path() {
	local file="$1"
	local base_dir=$(dirname "$file")
	local base_name=$(basename "$file")
	local sanitized_name=$(sanitize_filename "$base_name")
	echo "${base_dir}/.${sanitized_name}.rsrc.par2"
}

# Get path to the temporary location for a file's resource fork
# Get the basename for the temporary resource fork
get_resource_fork_temp_basename() {
	local file="$1"
	local base_name=$(basename "$file")
	local sanitized_name=$(sanitize_filename "$base_name")
	echo ".${sanitized_name}.rsrc"
}

get_abs_directory() {
	local directory="$1"
	local abs_directory
	# Check if directory exists
	# resolve it to an absolute path
	if ! abs_directory=$(resolve_realpath "$directory"); then
		echo "Error: Unable to resolve absolute path for '$directory'. Ensure greadlink (GNU coreutils) or perl is installed." >&2
		return 1
	fi
	if [[ ! -d "$abs_directory" ]]; then
		echo "Error: Directory '$directory' does not exist" >&2
		return 1
	fi
	echo "$abs_directory"
}

remove_par2_files_for_file() {
	local file="$1"
	local dir_path=$(dirname "$file")
	local basefilename=$(basename "$file")
	local sanitized_name=$(sanitize_filename "$basefilename")
	local files=()
	# trying to glob while preserving spaces in paths is disgusting in Bash /shrug
	shopt -s nullglob
	files=("$dir_path/.$sanitized_name"*.par2)
	for file in "${files[@]}"; do
		rm -f "$file" 2>/dev/null
	done
	shopt -u nullglob
}

# Calculate optimal block size for par2 based on file size
calculate_block_size() {
	local file_size="$1"
	local block_size

	# Calculate everything in one awk invocation:
	# - Convert to KB
	# - Calculate percentage using double exponential decay
	# - Calculate block size
	# - Enforce minimum of 4 bytes
	# - Round up to nearest multiple of 4
	read -r block_size < <($AWK -v size="$file_size" '
		BEGIN {
			# Convert to KB
			k = size / 1024

			# Calculate percentage using double exponential decay:
			# 1.2: Base percentage (asymptotic minimum)
			# 2.0 * exp(-0.001 * k): Slow decay term for gradual reduction from 1MB to 10MB
			# 21 * exp(-0.3 * k): Fast decay term for steep initial drop from 1KB to 100KB
			percent = 1.2 + 2.0 * exp(-0.001 * k) + 21 * exp(-0.3 * k)

			# Calculate block size in bytes
			block_size = int((size * percent) / 100)

			# Ensure minimum block size of 4
			if (block_size < 4) block_size = 4

			# Round up to nearest multiple of 4
			block_size = int((block_size + 3) / 4) * 4

			print block_size
		}
	')

	echo "$block_size"
}

# Function to check if a file should be processed
should_process_file() {
	local file="$1"
	local root="${2:-}"

	if par2_store_is_sqlite; then
		local db
		db=$(brg_par2_db_path)
		if [[ -n "$db" && "$file" == "$db" ]]; then
			return 1
		fi
	fi

	local basename
	basename=$(basename "$file")

	# Skip if file doesn't exist or is a par2 file
	if [[ ! -f "$file" ]] || [[ "$basename" == *.par2 || "$basename" == *.brg_empty ]]; then
		return 1
	fi

	# Skip dotfiles unless PROTECT_DOTFILES is enabled
	if [[ "$PROTECT_DOTFILES" != "1" && "$basename" == .* ]]; then
		return 1
	fi

	if should_ignore_path "$file" "$root"; then
		return 1
	fi

	return 0
}

# Process a single file for par2 operations
process_single_file() {
	local file="$1"
	local operation="$2"
	local root="${3:-}"
	if ! should_process_file "$file" "$root"; then
		return 0
	fi
	local file_dir
	file_dir=$(dirname "$file")
	local dir_time
	dir_time=$($STAT -c%Y "$file_dir")
	local base_name
	base_name=$(basename "$file")
	local par2_file
	par2_file=$(get_par2_path "$file")
	local has_rf=false

	if has_resource_fork "$file"; then
		local resource_fork_path
		resource_fork_path=$(get_resource_fork_path "$file")
		local resource_fork_par2_file
		resource_fork_par2_file=$(get_resource_fork_par2_path "$file")
		has_rf=true
	fi

	if $has_rf; then
		case "$operation" in
			create|verify|repair)
				local temp_rf_dir
				if ! temp_rf_dir=$(mktemp -d --tmpdir "brg_rsrc.XXXXXX"); then
					echo "Error: Failed to create temporary directory for resource fork of $file" >&2
					return 1
				fi
				local temp_resource_fork_path="$temp_rf_dir/$(get_resource_fork_temp_basename "$file")"
				;;
		esac
	fi

	case "$operation" in
		create)
			log_verbose "Creating protection for: $file"
			local file_size file_time
			file_size=$($STAT -c%s "$file") # NOTE: this is expected to be GNU stat!
			file_time=$($STAT -c%Y "$file") # NOTE: this is expected to be GNU stat!

			if [[ "$file_size" -eq 0 ]]; then
				local marker
				marker=$(get_empty_marker_path "$file")
				: > "$marker"
				$TOUCH -h --date="@$file_time" "$marker"
				echo "$file - Done."
				$TOUCH -h --date="@$dir_time" "$file_dir"
				return 0
			fi

			if [[ "$(brg_store_backend)" == "sqlite" ]]; then
				if ! brg_store_create_for_file "$file"; then
					return 1
				fi
				echo "$file - Done."
				$TOUCH -h --date="@$dir_time" "$file_dir"
				return 0
			fi

			if [[ -f "$par2_file" ]]; then
				debug "Skipping $file: its par2 file already exists"
				return 0
			fi

			debug "Par2 file will be: $par2_file"
			debug "Processing file: $file"
			local block_size=0
			block_size=$(calculate_block_size "$file_size")
			debug "File size: $file_size bytes, Block size: $block_size bytes"
			debug "PAR2 command: $PAR2 create -s$block_size -r$BRG_REDUNDANCY -n1 -T\"$NUM_PAR2_THREADS\" -a \"$par2_file\" \"$file\""

			# Remove existing par2 files first
			remove_par2_files_for_file "$file"

			if ! $PAR2 create -s"$block_size" -r"$BRG_REDUNDANCY" -n1 -T"$NUM_PAR2_THREADS" -a "$par2_file" "$file" >/dev/null; then
				echo -e "\nError creating par2 for $file" >&2
				return 1
			fi

			# Verify the par2 files were actually created
			if ! ls "${par2_file}"* >/dev/null 2>&1; then
				echo -e "\nPar2 files were not created for $file" >&2
				return 1
			fi

			# Set the par2 files' timestamps to match the original file
			debug "Setting timestamp $file_time on par2 files"
			for par2f in "${par2_file%.*}".vol*.par2 "${par2_file%.*}".par2; do
				debug "Setting timestamp on: $par2f"
				$TOUCH -h --date="@$file_time" "$par2f"
			done

			debug "Par2 file created: $(ls -la $par2_pattern)"
			if $has_rf; then
				debug "Creating par2 for resource fork: $resource_fork_path"
				debug "Resource fork par2 file will be: $resource_fork_par2_file"
				# Since par2 doesn't support resource forks,
				# we need to create a temporary file to hold the resource fork
				cat "$resource_fork_path" > "$temp_resource_fork_path"
				debug "Created temporary file to hold resource fork: $temp_resource_fork_path"
				local rf_size
				rf_size=$($STAT -c%s "$resource_fork_path") # NOTE: this is expected to be GNU stat!
				local rf_block_size
				rf_block_size=$(calculate_block_size "$rf_size")
				if ! $PAR2 create -s"$rf_block_size" -r"$BRG_REDUNDANCY" -n1 -T"$NUM_PAR2_THREADS" -B "$temp_rf_dir" -a "$resource_fork_par2_file" "$temp_resource_fork_path" >/dev/null; then
					echo -e "\nError creating par2 for resource fork of $file of length $rf_size" >&2
					rm -rf "$(dirname "$temp_resource_fork_path")"
					return 1
				fi

				rm -rf "$(dirname "$temp_resource_fork_path")"
				debug "Par2 file created: $resource_fork_par2_file"
				# Set resource fork par2 files' timestamps to match the resource fork
				local rsrc_time
				rsrc_time=$($STAT -c%Y "$resource_fork_path")
				for par2f in "${resource_fork_par2_file%.*}".vol*.par2 "${resource_fork_par2_file%.*}".par2; do
					$TOUCH -h --date="@$rsrc_time" "$par2f"
				done
			fi

			echo "$file - Done."
			$TOUCH -h --date="@$dir_time" "$file_dir"
			;;

		verify)
			log_verbose "Verifying: $file"
			if [[ "$(brg_store_backend)" == "sqlite" ]]; then
				local tmpdir main_par2
				if ! tmpdir=$(mktemp -d --tmpdir "brg_par2_verify.XXXXXX"); then
					echo "Error: Failed to create temporary directory for sqlite par2 verify" >&2
					return 1
				fi
				if ! main_par2=$(brg_store_materialize_latest_par2_set_for_file "$file" "$tmpdir"); then
					rm -rf "$tmpdir"
					return 0
				fi
				if ! $PAR2 verify -B"$file_dir" "$main_par2" "$file" >/dev/null; then
					rm -rf "$tmpdir"
					local canonical
					if ! canonical=$(resolve_realpath "$file"); then
						canonical="$file"
					fi
					echo "Verification failed for $canonical" >&2
					return 1
				fi
				rm -rf "$tmpdir"
				return 0
			fi

			[[ ! -f "$par2_file" ]] && return 0
			debug "Verifying file: $file"
			debug "Using par2 file: $par2_file"
			debug "PAR2 command: $PAR2 verify \"$par2_file\" \"$file\""
			if ! $PAR2 verify "$par2_file" "$file" >/dev/null; then
				local canonical
				if ! canonical=$(resolve_realpath "$file"); then
					canonical="$file"
				fi
				echo "Verification failed for $canonical" >&2
				return 1
			fi

			if $has_rf; then
				# Since par2 doesn't support resource forks,
				# we need to create a temporary file to hold the resource fork
				cat "$resource_fork_path" > "$temp_resource_fork_path"
				debug "Created temporary file to hold resource fork: $temp_resource_fork_path"
				debug "Verifying resource fork"
				# We used -a when creating, so the par2 files are at $resource_fork_par2_file
				# But par2 verify needs one of the par2 files as input.
				# When we verified the main file, we passed the par2 file.
				# Here we need to pass the resource fork par2 file.

				# Check if the resource fork par2 file exists
				if [[ ! -f "$resource_fork_par2_file" ]]; then
					# Try to find it via glob if exact name not found (though get_resource_fork_par2_path returns the .par2 file usually)
					# process_single_file create logic used "$resource_fork_par2_file" as the base name via -a.
					# so it created [base].par2 or [base].vol*.par2
					:
				fi

				if ! $PAR2 verify -B "$temp_rf_dir" "$resource_fork_par2_file" "$temp_resource_fork_path" >/dev/null; then
					local rf_canonical
					if ! rf_canonical=$(resolve_realpath "$file"); then
						rf_canonical="$file"
					fi
					echo "Resource fork verification failed for $rf_canonical" >&2
					rm -rf "$(dirname "$temp_resource_fork_path")"
					return 1
				fi
				debug "Resource fork verification successful"
				rm -rf "$(dirname "$temp_resource_fork_path")"
			fi
			# $TOUCH -h --date="@$dir_time" "$file_dir" # User requested to remove this for verify
			;;

		repair)
			log_verbose "Repairing: $file"
			if [[ "$(brg_store_backend)" == "sqlite" ]]; then
				local tmpdir main_par2
				if ! tmpdir=$(mktemp -d --tmpdir "brg_par2_repair.XXXXXX"); then
					echo "Error: Failed to create temporary directory for sqlite par2 repair" >&2
					return 1
				fi
				if ! main_par2=$(brg_store_materialize_latest_par2_set_for_file "$file" "$tmpdir"); then
					rm -rf "$tmpdir"
					return 0
				fi
				if ! $PAR2 repair -q -B"$file_dir" "$main_par2" "$file" >/dev/null; then
					rm -rf "$tmpdir"
					echo -e "\nError repairing $file" >&2
					return 1
				fi
				rm -rf "$tmpdir"
				echo "$file - Done."
				$TOUCH -h --date="@$dir_time" "$file_dir"
				return 0
			fi

			[[ ! -f "$par2_file" ]] && return 0
			debug "Repairing file: $file"
			debug "Using par2 file: $par2_file"
			debug "File exists: $(ls -l "$file")"
			debug "Par2 file exists: $(ls -l "$par2_file")"
			debug "Directory contents before repair: $(ls -la "$file_dir")"
			debug "File content before repair: $(cat "$file")"
			debug "Par2 file content (hex): $(xxd -p -l 30 "$par2_file")"
			debug "PAR2 command: $PAR2 repair -q \"$par2_file\" \"$file\""

			if $has_rf; then
				# Since par2 doesn't support resource forks,
				# we need to create a temporary file to hold the resource fork
				cat "$resource_fork_path" > "$temp_resource_fork_path"
				debug "cat $resource_fork_path > $temp_resource_fork_path"
				debug "Created temporary file to hold resource fork: $temp_resource_fork_path"
			fi
			# PAR2's repair obliterates any resource forks. Hence the logic here.
			if ! $PAR2 repair -q "$par2_file" "$file"; then
				echo -e "\nError repairing $file" >&2
				$has_rf && rm -rf "$(dirname "$temp_resource_fork_path")"
				return 1
			fi
			debug "$(if $has_rf; then echo "Data fork of f"; else echo "F"; fi)ile repaired: $(ls -l "$file")"
			if $has_rf; then
				debug "Repairing resource fork"
				debug "PAR2 command: $PAR2 repair -q \"$resource_fork_par2_file\" \"$temp_resource_fork_path\""
				if ! $PAR2 repair -q -B "$temp_rf_dir" "$resource_fork_par2_file" "$temp_resource_fork_path"; then
					debug "Resource fork repair failed for $file"
					debug "Detailed error output: $($PAR2 repair "$resource_fork_par2_file" "$temp_resource_fork_path" 2>&1)"
					rm -rf "$(dirname "$temp_resource_fork_path")"
					return 1
				fi
				debug "Resource fork repaired in temporary location: $(ls -l "$temp_resource_fork_path")"
				debug "Copying temporary resource fork back to: $resource_fork_path"
				cat "$temp_resource_fork_path" > "$resource_fork_path"
				rm -rf "$(dirname "$temp_resource_fork_path")"
			fi

			debug "Directory contents after repair: $(ls -la "$file_dir")"
			debug "File content after repair: $(cat "$file")"
			echo "$file - Done."
			$TOUCH -h --date="@$dir_time" "$file_dir"
			;;

		clear)
			log_verbose "Clearing protection for: $file"
			if [[ "$(brg_store_backend)" == "sqlite" ]]; then
				if ! brg_store_clear_for_file "$file"; then
					return 1
				fi
				$TOUCH -h --date="@$dir_time" "$file_dir"
				return 0
			fi

			remove_par2_files_for_file "$file"
			$TOUCH -h --date="@$dir_time" "$file_dir"
			;;

		update)
			log_verbose "Checking for updates: $file"
			local file_size
			file_size=$($STAT -c%s "$file") # NOTE: this is expected to be GNU stat!
			if [[ "$file_size" -eq 0 ]]; then
				process_single_file "$file" clear "$root"
				process_single_file "$file" create "$root"
				return $?
			fi

			if [[ "$(brg_store_backend)" == "sqlite" ]]; then
				local file_time stored_time
				file_time=$($STAT -c%Y "$file")
				stored_time=$(brg_store_latest_mtime_for_file "$file" 2>/dev/null || true)
				if [[ -z "${stored_time:-}" ]]; then
					process_single_file "$file" create "$root"
					return $?
				fi
				if (( file_time > stored_time )); then
					process_single_file "$file" clear "$root"
					process_single_file "$file" create "$root"
					return $?
				fi
				return 0
			fi

			if [[ ! -f "$par2_file" ]]; then
				process_single_file "$file" create "$root"
				return $?
			fi

			local file_time
			file_time=$($STAT -c%Y "$file") # NOTE: this is expected to be GNU stat!
			local par2_time
			par2_time=$($STAT -c%Y "$par2_file") # NOTE: this is expected to be GNU stat!

			local needs_update=0
			if (( file_time > par2_time )); then
				needs_update=1
			fi

			# Check resource fork if present
			if $has_rf; then
				if [[ -f "$resource_fork_par2_file" ]]; then
					local rsrc_time
					rsrc_time=$($STAT -c%Y "$resource_fork_path") # NOTE: this is expected to be GNU stat!
					local rsrc_par2_time
					rsrc_par2_time=$($STAT -c%Y "$resource_fork_par2_file") # NOTE: this is expected to be GNU stat!
					if (( rsrc_time > rsrc_par2_time )); then
						needs_update=1
					fi
				else
					needs_update=1
				fi
			fi

			if [[ $needs_update -eq 1 ]]; then
				debug "File or resource fork is newer, regenerating"
				process_single_file "$file" clear "$root"
				process_single_file "$file" create "$root"
				return $?
			fi
			;;

		stats)
			local total_size=0
			total_size=$($STAT -c%s "$file") # NOTE: this is expected to be GNU stat!

			if $has_rf; then
				local rsrc_size
				rsrc_size=$($STAT -c%s "$resource_fork_path") # NOTE: this is expected to be GNU stat!
				((total_size += rsrc_size))
			fi

			if [[ "$(brg_store_backend)" == "sqlite" ]]; then
				local stored_time
				stored_time=$(brg_store_latest_mtime_for_file "$file" 2>/dev/null || true)
				if [[ -n "${stored_time:-}" ]]; then
					echo "$total_size:covered"
				else
					echo "$total_size:uncovered"
				fi
				return 0
			fi

			if [[ -f "$par2_file" ]] && ( ! $has_rf || [[ -f "$resource_fork_par2_file" ]] ); then
				echo "$total_size:covered"
			else
				echo "$total_size:uncovered"
			fi
			;;

		*)
			echo "Error: Unknown operation: $operation"
			return 1
			;;
	esac

	return 0
}

# Create par2 files recursively
create_par2s() {
	local target="$1"

	debug "Attempting create on target: $target"

	if [[ -f "$target" ]]; then
		debug "Target is a file, calling process_single_file $target create"
		process_single_file "$target" create "$(dirname "$target")"
		return $?
	fi

	if [[ ! -d "$target" ]]; then
		echo "Error: $target is not a file or directory" >&2
		return 1
	fi

	while IFS= read -r -d '' file; do
		if should_ignore_path "$file" "$target"; then
			debug "Skipping ignored path during create: $file"
			continue
		fi
		debug "Creating protection for $file in directory: $target"
		process_single_file "$file" create "$target"
	done < <(find "$target" -type f -not -name "*.par2" -print0)
}

# Update par2 files
update_par2s() {
	local target="$1"

	debug "Attempting update on target: $target"

	if [[ -f "$target" ]]; then
		local file_root
		file_root=$(dirname "$target")
		if should_process_file "$target" "$file_root"; then
			debug "Target is a file, calling process_single_file $target update"
			process_single_file "$target" update "$file_root"
			return $?
		else
			debug "Target $target is a file, but should not be processed, skipping"
			return 0
		fi
	fi

	if [[ ! -d "$target" ]]; then
		echo "Error: $target is not a file or directory" >&2
		return 1
	fi

	echo "Scanning for par2 files in $target..."

	# Count total par2 files that are not resource fork par2 files for progress indication
	local total_par2_files
	total_par2_files=$(find "$target" -type f -not -name ".*.rsrc.par2" -name ".*.par2" -print0 | tr -cd '\0' | wc -c | $AWK '{print $1}')
	echo "Found $total_par2_files par2 files to check"

	# First, remove orphaned par2 files and their associated volume files
	local processed_files=0
	local par2_dir par2_base orig_base
	while IFS= read -r -d '' par2_file; do
		processed_files=$((processed_files + 1))
		if ((processed_files % 100 == 0)); then
			echo "Checking par2 files... ($processed_files/$total_par2_files)"
		fi

		if should_ignore_path "$par2_file" "$target"; then
			debug "Skipping ignored par2 file: $par2_file"
			continue
		fi

		par2_dir=$(dirname "$par2_file")
		par2_base=$(basename "$par2_file")

		# Extract the base name (without .par2 or .volX+Y)
		if [[ "$par2_base" =~ \.vol ]]; then
			orig_base="${par2_base%%.vol*}"
		else
			orig_base="${par2_base%.par2}"
		fi
		orig_base="${orig_base#.}"  # Remove leading dot

		# Skip if this is a dotfile and we're not protecting them
		if [[ "$PROTECT_DOTFILES" != "1" && "$orig_base" == .* ]]; then
			debug "Skipping dotfile: $orig_base (PROTECT_DOTFILES=$PROTECT_DOTFILES)"
			continue
		fi

		# Skip if this is a par2 file (regardless of extension)
		if [[ "$orig_base" =~ \.(par2|vol[0-9]+\+[0-9]+\.par2)$ ]]; then
			debug "Skipping par2 file: $orig_base"
			continue
		fi

		# Check if the original file exists
		if [[ ! -f "$par2_dir/$orig_base" ]]; then
			# Only process each set once (when we find the first file)
			if [[ ! -f "$par2_dir/.$orig_base.par2" ]] || [[ "$par2_file" == "$par2_dir/.$orig_base.par2" ]]; then
				echo "Removing orphaned par2 files: $par2_file"
				rm "$par2_dir/.$orig_base.par2" "$par2_dir/.$orig_base.rsrc.par2" "$par2_dir/.$orig_base.vol"* 2>/dev/null || true
			fi
		fi
	done < <(find "$target" -type f -not -name ".*.rsrc.par2" -name ".*.par2" -print0)

	echo "par2 file check complete"
	echo "Scanning for files needing par2 updates..."

	# Count total files for progress indication, excluding dotfiles if not protected
	local total_files
	if [[ "$PROTECT_DOTFILES" == "1" ]]; then
		total_files=$(find "$target" -type f -not -name "*.par2" -print0 | tr -cd '\0' | wc -c | $AWK '{print $1}')
	else
		total_files=$(find "$target" -type f -not -name ".*" -not -name "*.par2" -print0 | tr -cd '\0' | wc -c | $AWK '{print $1}')
	fi
	echo "Found $total_files files to process"

	# Then update/create par2 files as needed
	processed_files=0
	while IFS= read -r -d '' file; do
		if ! should_process_file "$file" "$target"; then
			continue
		fi
		processed_files=$((processed_files + 1))
		if ((processed_files % 100 == 0)); then
			echo "Processing files... ($processed_files/$total_files)"
		fi
		debug "Updating file: $file"
		process_single_file "$file" update "$target"
	done < <(find "$target" -type f -not -name "*.par2" -print0)

	echo "Update complete"
}

# Verify par2 files recursively
verify_par2s() {
	local target="$1"
	local exit_code=0

	debug "Attempting verify on target: $target"

	if [[ -f "$target" ]]; then
		debug "Target is a file, calling process_single_file $target verify"
		process_single_file "$target" verify "$(dirname "$target")"
		return $?
	fi

	if [[ ! -d "$target" ]]; then
		echo "Error: $target is not a file or directory" >&2
		return 1
	fi

	debug "Target is a directory, processing files recursively"
	while IFS= read -r -d '' file; do
		if should_ignore_path "$file" "$target"; then
			debug "Skipping ignored path during verify: $file"
			continue
		fi
		debug "Verifying protection for file: $file"
		if ! process_single_file "$file" verify "$target"; then
			exit_code=1
		fi
	done < <(find "$target" -type f -not -name "*.par2" -print0)

	return $exit_code
}

# Repair files using par2
repair_par2s() {
	local target="$1"
	local exit_code=0

	debug "Attempting repair on target: $target"

	if [[ -f "$target" ]]; then
		debug "Target is a file, calling process_single_file $target repair"
		process_single_file "$target" repair "$(dirname "$target")"
		return $?
	fi

	if [[ ! -d "$target" ]]; then
		echo "Error: $target is not a file or directory" >&2
		return 1
	fi

	debug "Target is a directory, processing files recursively"
	while IFS= read -r -d '' file; do
		if should_ignore_path "$file" "$target"; then
			debug "Skipping ignored path during repair: $file"
			continue
		fi
		debug "Repairing file if necessary: $file"
		if ! process_single_file "$file" repair "$target"; then
			exit_code=1
		fi
	done < <(find "$target" -type f -not -name "*.par2" -print0)

	return $exit_code
}

# Clear all par2 files
clear_par2s() {
	local target="$1"

	debug "Attempting clear on target: $target"

	if [[ -f "$target" ]]; then
		debug "Target is a file, calling process_single_file $target clear"
		process_single_file "$target" clear "$(dirname "$target")"
		return $?
	fi

	if [[ ! -d "$target" ]]; then
		echo "Error: $target is not a file or directory" >&2
		return 1
	fi

	if par2_store_is_sqlite; then
		sqlite_clear_scope "$target"
		while IFS= read -r -d '' marker; do
			if should_ignore_path "$marker" "$target"; then
				continue
			fi
			rm -f "$marker" 2>/dev/null || true
		done < <(find "$target" -type f -name "*.brg_empty" -print0)
		return $?
	fi

	debug "Target $target is a directory, processing files recursively"
	while IFS= read -r -d '' par2_file; do
		if should_ignore_path "$par2_file" "$target"; then
			debug "Skipping removal inside ignored path: $par2_file"
			continue
		fi
		echo "Removing: $par2_file"
		rm "$par2_file"
	done < <(find "$target" -type f -name "*.par2" -print0)
}

# Calculate par2 coverage statistics
stats_par2s() {
	local target="$1"
	local covered_bytes=0
	local uncovered_bytes=0
	local coverage_percent=0
	local stats_output=""
	local file_count=0

	if [[ -f "$target" ]]; then
		stats_output=$(process_single_file "$target" stats "$(dirname "$target")")
		[[ -z "$stats_output" ]] && return 0
		((file_count++))
		IFS=: read -r bytes status <<< "$stats_output"
		if [[ "$status" == "covered" ]]; then
			covered_bytes=$((covered_bytes + bytes))
		else
			uncovered_bytes=$((uncovered_bytes + bytes))
		fi
	elif [[ -d "$target" ]]; then
		while IFS= read -r -d '' file; do
			if should_ignore_path "$file" "$target"; then
				continue
			fi
			stats_output=$(process_single_file "$file" stats "$target")
			[[ -z "$stats_output" ]] && continue
			((file_count++))
			IFS=: read -r bytes status <<< "$stats_output"
			if [[ "$status" == "covered" ]]; then
				covered_bytes=$((covered_bytes + bytes))
			else
				uncovered_bytes=$((uncovered_bytes + bytes))
			fi
		done < <(find "$target" -type f -not -name "*.par2" -print0)
	else
		echo "Error: $target is not a file or directory" >&2
		return 1
	fi

	local total_bytes=$((covered_bytes + uncovered_bytes))
	if [[ $total_bytes -gt 0 ]]; then
		coverage_percent=$(echo "scale=2; ($covered_bytes * 100) / $total_bytes" | bc)
	else
		coverage_percent="100.00"
	fi

	# Output statistics
	echo "Statistics for $target:"
	echo "Files processed: $file_count"
	echo "Total bytes: $total_bytes"
	echo "Covered bytes: $covered_bytes"
	echo "Uncovered bytes: $uncovered_bytes"
	echo "Coverage: ${coverage_percent}%"
}

# Debug status
debug_mode() {
	[ -n "${DEBUG}" ] && true || false
}

# Debug output function
debug() {
	debug_mode && echo "DEBUG: $*" >&2
}

# Verbose output function
log_verbose() {
	if [[ "${VERBOSE:-0}" -eq 1 ]]; then
		echo "$@" >&2
	fi
}

show_about() {
	echo "$PROJECT_DESCRIPTION"
}

# Print usage information
show_help() {
	local cmd_name
	cmd_name=$(basename "$0")
	cat >&2 <<EOF
${cmd_name} - Create and manage file redundancy at the directory level

Usage: $cmd_name <command> [<file_or_directory>]

Commands:
  help     Display this help message
  about    Show a one-line description of Bitrot Guard
  create   Create par2 files for all files in directory or a single file
  update   Update par2 files for modified files in directory or a single file
  verify   Verify all par2 files in directory or a single file
  repair   Repair any corrupted files in directory or a single file
  clear    Remove all par2 files in directory or for a single file
  prune    Remove par2 data with no source file
  stats    Show par2 coverage statistics for directory or a single file
  test     Run test suite

par2 (which is doing most of the heavy lifting here) by default works at the
individual file level and allows you to specify a percentage of repairable
redundancy (5% by default). This means that up to 5% of the file's content can
be corrupted before the file is considered beyond repair. This extra information
is written into par2 files which add about 5% to the total space used.
But par2 is really designed to work across a giant segmented archive file (which
was its original use-case), and not at the individual file or directory level.

${cmd_name} applies this at the directory level, across every file, recursively.

For small files, it intelligently chooses the most efficient block size to
get as close to the covered percentage as possible in terms of extra space
utilized. (There is some inevitable waste for really small files, though.)

On macOS, it also does special handling around resource forks, which are not
supported by par2 by default.

By default, the par2 files are created as hidden files (prefixed with '.', i.e.,
dotfiles) colocated in the same directory as the source files.

Optionally, you can store the par2 files in a centralized sqlite database (see
BRG_PAR2_STORE / --par2-store). When using sqlite storage, the database file is
automatically excluded from protection (you can protect it separately).

Each set of one or more par2 files includes a default 5% redundancy. Block size
is calculated as a percentage of the original file size using a double
exponential decay formula (which was empirically determined to be the most
effective, separately):
  1.2: Base percentage (asymptotic minimum)
  2.0 * e^(-0.001 * k): Slow decay term for gradual reduction from 1MB to 10MB
  21 * e^(-0.3 * k): Fast decay term for steep initial drop from 1KB to 100KB
where k is the file size in kilobytes (KB). With 5% redundancy, this provides
optimal block sizes in proportion to file size as follows:
  ~18-21% of file size for 1KB files
    (note that small files are rather inefficient with par2 currently,
    regardless of block size, but I tried!)
  ~4-7% of file size for 10KB files
  ~3-5% of file size for 50-100KB files
  ~1.2-2% of file size for 1MB files
  ~1.2% of file size for 10MB+ files
The block size is always rounded up to the nearest multiple of 4 bytes
(per par2 requirements).

There's also a fairly comprehensive test suite, which you can run with:
  > ${cmd_name} test
or directly via:
  > ./test/test.sh

Environment Variables:
  NUM_PAR2_THREADS  Number of threads to use for par2 operations.
					Defaults to the number of CPU cores if not set.
					Example: NUM_PAR2_THREADS=4 ./${cmd_name} create /path/to/dir
  BRG_REDUNDANCY    BitrotGuard redundancy percentage (5 means roughly 5% extra data for recovery).
					Defaults to 5 if not set.
					Example: BRG_REDUNDANCY=10 ./${cmd_name} create /path/to/dir
  PROTECT_DOTFILES  Protect dotfiles (files starting with .).
					Defaults to 1 (true) if not set (dotfiles will not get skipped).
					Example: PROTECT_DOTFILES=0 ./${cmd_name} create /path/to/dir
  BRG_IGNORE_PATTERNS  Colon-separated glob patterns to skip (works like PATH).
					Defaults to ignoring .git/.jj directories (including nested ones).
					Example: BRG_IGNORE_PATTERNS="*.bak:node_modules/**" ./${cmd_name} update /path
  BRG_PAR2_STORE     Par2 storage backend: filesystem (default) or sqlite.
					Example: BRG_PAR2_STORE=sqlite ./${cmd_name} create /path/to/dir
  BRG_PAR2_DB_PATH   Path to sqlite db when BRG_PAR2_STORE=sqlite.
					Defaults to ${XDG_DATA_HOME:-\$HOME/.local/share}/bitrot_guard/par2.sqlite3
					Example: BRG_PAR2_DB_PATH=~/brg.sqlite3 BRG_PAR2_STORE=sqlite ./${cmd_name} create /path/to/dir

Ignore patterns can also be listed one per line in
  ${XDG_CONFIG_HOME:-\$HOME/.config}/bitrot_guard/ignore
Lines beginning with # are treated as comments.

Dependencies:
par2, of course (the Nix package I used is par2cmdline-turbo).
The GNU (not BSD which is the Mac default!) versions of stat, touch and sed
are currently required. You can install these via homebrew or your distro's
package manager (although in the case of Linux, these are likely the default).
It is assumed that these tools are available in the PATH via gstat, gtouch
and sed. (On Nix[OS]/nix-darwin, the coreutils-prefixed package provides this,
in case you don't want to shadow the BSD versions, which I recommend.)
EOF
}

# Main execution (if script is run directly)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	# Parse recognized flags first
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-v|--verbose)
				VERBOSE=1
				shift
				;;
			--par2-store)
				shift
				if [[ $# -lt 1 || -z "${1:-}" ]]; then
					echo "Error: --par2-store requires a value (filesystem|sqlite)." >&2
					exit 1
				fi
				BRG_PAR2_STORE="$1"
				shift
				;;
			--par2-store=*)
				BRG_PAR2_STORE="${1#--par2-store=}"
				shift
				;;
			--par2-db|--par2-sqlite-db|--par2-sqlite-path)
				shift
				if [[ $# -lt 1 || -z "${1:-}" ]]; then
					echo "Error: --par2-db requires a path." >&2
					exit 1
				fi
				BRG_PAR2_DB_PATH="$1"
				shift
				;;
			--par2-db=*|--par2-sqlite-db=*|--par2-sqlite-path=*)
				BRG_PAR2_DB_PATH="${1#*=}"
				shift
				;;
			*)
				break
				;;
		esac
	done

	raw_command="$1"
	directory="$2"

	ensure_target_arg_provided() {
		if [[ $# -eq 0 ]]; then
			echo -ne "Error: No action specified. Use --help to see available actions.\n\n" >&2
			show_help
			exit 1
		fi
	}

	ensure_target_arg_provided "$@"

	if [[ "$raw_command" == "--test" ]]; then
		if [[ ! -x "$TEST_SCRIPT" ]]; then
			echo "Error: Test suite not found at $TEST_SCRIPT" >&2
			exit 1
		fi
		QUIET=1 "$TEST_SCRIPT" "$0"
		exit $?
	fi

	command="$raw_command"
	# Allow subcommands to be prefixed with --
	if [[ "$command" == --* && "$command" != "--" ]]; then
		command="${command#--}"
	fi

	# Another pass to check for verbose flag if it was passed as part of subcommand arguments (e.g. subcommand -v)
	# This is a bit hacky but allows `bitrot_guard verify -v path`
	for arg in "$@"; do
		if [[ "$arg" == "-v" || "$arg" == "--verbose" ]]; then
			VERBOSE=1
		fi
	done

	case "$command" in
		help|-h|--help)
			show_help
			exit 0
			;;
		about|-a|--about)
			show_about
			exit 0
			;;
		test)
			if [[ ! -x "$TEST_SCRIPT" ]]; then
				echo "Error: Test suite not found at $TEST_SCRIPT" >&2
				exit 1
			fi
			"$TEST_SCRIPT" "$0"
			exit $?
			;;
		queue-plan)
			queue_plan
			exit $?
			;;
		queue-files)
			mode="$2"
			target="$3"
			if [[ -z "$mode" || -z "$target" ]]; then
				echo -ne "Error: queue-files requires a mode and target path.\n\n" >&2
				show_help
				exit 1
			fi
			queue_files_command "$mode" "$target"
			exit $?
			;;
		create|update|verify|repair|clear|stats|prune)
			if [[ -z "$directory" ]]; then
				echo -ne "Error: No target specified. Please provide a file or directory path.\n\n" >&2
				show_help
				exit 1
			fi
			if [[ "$command" == "prune" ]]; then
				brg_store_prune_scope "$directory"
				exit $?
			fi

			"${command}_par2s" "$directory"
			exit $?
			;;
		*)
			echo -ne "Error: Unknown action '$command'. Use --help to see available actions.\n\n" >&2
			show_help
			exit 1
			;;
	esac
fi
